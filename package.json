{
  "name": "@ryze-digital/cookie-consent",
  "version": "1.2.0",
  "description": "Abstracts and standardizes the implementation of cookie consent managers, such as Cookiebot or OneTrust",
  "main": "index.js",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "license": "MIT",
  "type": "module",
  "repository": "github:ryze-digital/cookie-consent",
  "scripts": {
    "lint": "npm run lint:scripts",
    "lint:scripts": "prettier src/scripts tests/scripts ./*.js --check && eslint src/scripts tests/scripts ./*.js",
    "lint-fix": "npm run lint-fix:scripts",
    "lint-fix:scripts": "prettier src/scripts tests/scripts ./*.js --write && npm run lint:scripts -- --fix",
    "test": "npm run test:scripts",
    "test:scripts": "jest",
    "test:scripts:coverage": "jest --coverage",
    "build": "npm-run-all --parallel build:*",
    "build:scripts": "webpack",
    "watch": "npm-run-all --parallel watch:*",
    "watch:scripts": "webpack --watch",
    "docs": "npm-run-all --parallel docs:*",
    "docs:scripts": "jsdoc src/scripts/* -d docs/scripts",
    "prebuild": "node pre-build.js"
  },
  "dependencies": {
    "@ryze-digital/js-utilities": "^1.3.0"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jsdoc": "^4.0.5",
    "npm-run-all2": "^9.0.4",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "keywords": [
    "javascript",
    "js",
    "cookiebot",
    "onetrust",
    "cookieconsent"
  ],
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  }
}
